<!--
  AppStream metadata: what software centres show for Cerno. The .deb installs it into
  /usr/share/metainfo, the AppImage carries it in the same place. CI checks it with
  `appstreamcli validate`, and that the newest release below is Cargo.toml's version with
  its date in CHANGELOG.md – a release adds its line at the top.
-->
<component type="desktop-application">
  <id>io.github.fly2nbc_oss.cerno</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name>Cerno</name>
  <summary>Fast photo viewer and culling tool</summary>
  <summary xml:lang="de">Schneller Fotobetrachter zum Sichten und Bewerten</summary>
  <summary xml:lang="fr">Visionneuse rapide pour trier et noter vos photos</summary>
  <summary xml:lang="es">Visor rápido para seleccionar y valorar fotos</summary>
  <summary xml:lang="it">Visualizzatore veloce per selezionare e valutare foto</summary>

  <developer id="io.github.fly2nbc_oss">
    <name>fly2nbc-oss</name>
  </developer>

  <description>
    <p>
      Cerno helps you go through a folder of photos quickly and keep the good ones. It
      switches between photos instantly, rates them from the keyboard and writes stars,
      colour labels, comments and keywords straight into the file, where other photo
      programs find them – the file's dates stay exactly as they were. Everything runs on
      your computer.
    </p>
    <ul>
      <li>Instant switching: the photos around the current one are loaded in advance</li>
      <li>Stars, reject and colour labels from the keyboard; Ctrl+Z takes the last marks back</li>
      <li>Aesthetics and sharpness scores, computed locally, to sort and filter by</li>
      <li>Bursts, exact duplicates, blurry shots, similar photos and photos with people at a glance</li>
      <li>Compare two or four photos side by side, or see the whole folder as a grid</li>
      <li>RAW and JPG of the same shot as one photo</li>
      <li>Straighten, crop and rotate JPEGs; the original is kept</li>
      <li>Deleting moves a photo aside, never into oblivion</li>
      <li>JPEG, HEIC, PNG, TIFF, WebP, BMP, GIF, RAW previews and videos with sound</li>
      <li>German, English, French, Spanish and Italian</li>
    </ul>
    <p>
      Writing marks needs ExifTool (package libimage-exiftool-perl).
    </p>
  </description>

  <launchable type="desktop-id">cerno.desktop</launchable>
  <provides>
    <binary>cerno</binary>
  </provides>

  <url type="homepage">https://github.com/fly2nbc-oss/Cerno</url>
  <url type="bugtracker">https://github.com/fly2nbc-oss/Cerno/issues</url>
  <url type="vcs-browser">https://github.com/fly2nbc-oss/Cerno</url>

  <screenshots>
